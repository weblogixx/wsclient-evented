{
  "name": "wsclient-evented",
  "version": "2.3.0",
  "description": "Simple Websocket Client with Event support",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/emitter.js",
    "lib/index.d.mts",
    "dist/wsclientevented.js"
  ],
  "scripts": {
    "lint": "oxlint lib test scripts example",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/*.test.mjs\"",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --watch \"test/*.test.mjs\"",
    "demo": "npm run build && node example/server.mjs",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "preversion": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://weblogixx@github.com/weblogixx/wsclient-evented.git"
  },
  "keywords": [
    "websocket",
    "websocket client",
    "event"
  ],
  "author": "Christian Schilling (cs@weblogixx.de)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/weblogixx/wsclient-evented/issues"
  },
  "homepage": "https://github.com/weblogixx/wsclient-evented#readme",
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "esbuild": "^0.28.2",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  },
  "types": "lib/index.d.mts"
}
